    "async-mutex": "^0.4.1",
    "bootstrap": "5.3.2",
    "dayjs": "1.11.10",
    "dotenv": "^16.4.5",
    "i18next": "^23.10.0",
    "leaflet": "1.9.4",
    "lodash": "4.17.21",
    "path-browserify": "1.0.1",
    "react": "18.2.0",
